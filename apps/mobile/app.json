{
  "expo": {
    "name": "uberCTRL",
    "slug": "uberctrl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "space.feif.uberctrl"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "space.feif.uberctrl"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Zum Scannen des Kopplungs-Codes, den die Web-Ansicht anzeigt. Es wird nichts aufgezeichnet."
        }
      ],
      "react-native-quick-crypto",
      "./plugins/withCmakeVersion",
      "./plugins/withDeviceAbi"
    ],
    "scheme": "uberctrl",
    "experiments": {
      "typedRoutes": true
    }
  }
}
